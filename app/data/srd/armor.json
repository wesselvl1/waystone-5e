    {
      "id": "unarmored",
      "name": "Unarmored",
      "category": "unarmored",
      "baseAC": 10,
      "description": "No armor at all: 10 plus your Dexterity modifier."
    },
    {
      "id": "unarmored-defense-barbarian",
      "name": "Unarmored Defense (Barbarian)",
      "category": "unarmored",
      "baseAC": 10,
      "extraAbility": "con",
      "classId": "barbarian",
      "description": "While you are not wearing any armor, your AC equals 10 + your Dexterity modifier + your Constitution modifier. You can use a shield and still gain this benefit."
    },
    {
      "id": "unarmored-defense-monk",
      "name": "Unarmored Defense (Monk)",
      "category": "unarmored",
      "baseAC": 10,
      "extraAbility": "wis",
      "shieldAllowed": false,
      "classId": "monk",
      "description": "While you are wearing no armor and not wielding a shield, your AC equals 10 + your Dexterity modifier + your Wisdom modifier."
    },
