# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Packed non-SRD rulepacks (scripts/pack-rulepacks.mjs). Kept out of dist/, which is
# Nuxt's link to the deployed .output/public.
/out

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Data
/data

# Rulepack data: allow-list. Only app/data/srd/ may be committed — every other
# folder under app/data is non-SRD dev data and must never enter git.
/app/data/*
!/app/data/srd/

# MCP server config: points at an absolute path on one machine, so it is local-only
/.mcp.json
